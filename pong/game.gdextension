[configuration]

entry_symbol = "godot_bend_init"
compatibility_minimum = "4.4"

[libraries]

macos = "res://bin/libgame.dylib"
linux.x86_64 = "res://bin/libgame.so"
linux.arm64 = "res://bin/libgame.so"
android.arm64 = "res://bin/libgame.android.arm64.so"
ios.debug = "res://bin/libgame.xcframework"
ios.release = "res://bin/libgame.xcframework"

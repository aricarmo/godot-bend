# An inherited method is in Range.bend: objects are one type,
# so it takes a ScrollBar as it is.
import Base
import ../Godot.bend as Godot

def set_custom_step(self: Godot.Object, step: F32) -> IO(Unit):
  Godot.run(self, "set_custom_step", [Godot.VFloat{step}])

def get_custom_step(self: Godot.Object) -> IO(F32):

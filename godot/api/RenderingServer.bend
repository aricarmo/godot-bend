def get_frame_setup_time_cpu(self: Godot.Object) -> IO(F32):
  Godot.call_float(self, "get_frame_setup_time_cpu", [])

def force_sync(self: Godot.Object) -> IO(Unit):
  Godot.run(self, "force_sync", [])

def force_draw(self: Godot.Object) -> IO(Unit):
  Godot.run(self, "force_draw", [])

def force_draw.all(
  self: Godot.Object, swap_buffers: Bool, frame_step: F32
) -> IO(Unit):
  Godot.run(self, "force_draw", [
    Godot.VBool{swap_buffers}, Godot.VFloat{frame_step}])

def get_rendering_device(self: Godot.Object) -> IO(Godot.Object):
  Godot.call_obj(self, "get_rendering_device", [])

def create_local_rendering_device(self: Godot.Object) -> IO(Godot.Object):
  Godot.call_obj(self, "create_local_rendering_device", [])

def is_on_render_thread(self: Godot.Object) -> IO(Bool):
  Godot.call_bool(self, "is_on_render_thread", [])

def call_on_render_thread(self: Godot.Object, callable: U32) -> IO(Unit):
  Godot.run(self, "call_on_render_thread", [Godot.VCall{callable}])

def has_feature(self: Godot.Object, feature: U32) -> IO(Bool):
  Godot.call_bool(self, "has_feature", [Godot.VInt{feature}])

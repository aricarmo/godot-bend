def texture_2d_create(self: Godot.Object, image: Godot.Object) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_2d_create", [Godot.VObj{image}])
    return Godot.to_rid(v)

def texture_2d_layered_create(
  self: Godot.Object, layers: List<&2, Godot.Variant>, layered_type: U32
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_2d_layered_create", [Godot.VArr{layers}, Godot.VInt{layered_type}])
    return Godot.to_rid(v)

def texture_3d_create(
  self: Godot.Object, format: U32, width: U32, height: U32, depth: U32,
  mipmaps: Bool, data: List<&2, Godot.Variant>
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_3d_create", [Godot.VInt{format}, Godot.VInt{width}, Godot.VInt{height}, Godot.VInt{depth}, Godot.VBool{mipmaps}, Godot.VArr{data}])
    return Godot.to_rid(v)

def texture_proxy_create(self: Godot.Object, base: Godot.Rid) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_proxy_create", [Godot.rid(base)])
    return Godot.to_rid(v)


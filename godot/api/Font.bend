def find_variation(
  self: Godot.Object, variation_coordinates: Godot.Variant
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "find_variation", [variation_coordinates])
    return Godot.to_rid(v)

def find_variation.all(
  self: Godot.Object, variation_coordinates: Godot.Variant, face_index: U32,
  strength: F32, transform: Godot.Transform2D, spacing_top: U32,
  spacing_bottom: U32, spacing_space: U32, spacing_glyph: U32,
  baseline_offset: F32
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "find_variation", [variation_coordinates, Godot.VInt{face_index}, Godot.VFloat{strength}, Godot.transform2d(transform), Godot.VInt{spacing_top}, Godot.VInt{spacing_bottom}, Godot.VInt{spacing_space}, Godot.VInt{spacing_glyph}, Godot.VFloat{baseline_offset}])
    return Godot.to_rid(v)


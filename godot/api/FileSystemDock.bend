# FileSystemDock
# ==============

# Godot's FileSystemDock (inherits EditorDock), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 3
# methods; left out: none.
# An inherited method is in EditorDock.bend: objects are one type,
# so it takes a FileSystemDock as it is.
import Base
import ../Godot.bend as Godot

def navigate_to_path(self: Godot.Object, path: String) -> IO(Unit):
  Godot.run(self, "navigate_to_path", [Godot.VStr{path}])

def add_resource_tooltip_plugin(
  self: Godot.Object, plugin: Godot.Object
) -> IO(Unit):
  Godot.run(self, "add_resource_tooltip_plugin", [Godot.VObj{plugin}])

def remove_resource_tooltip_plugin(
  self: Godot.Object, plugin: Godot.Object
) -> IO(Unit):
  Godot.run(self, "remove_resource_tooltip_plugin", [Godot.VObj{plugin}])

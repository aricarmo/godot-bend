def set_length(self: Godot.Object, time_sec: F32) -> IO(Unit):
  Godot.run(self, "set_length", [Godot.VFloat{time_sec}])

def get_length(self: Godot.Object) -> IO(F32):
  Godot.call_float(self, "get_length", [])

def set_loop_mode(self: Godot.Object, loop_mode: U32) -> IO(Unit):
  Godot.run(self, "set_loop_mode", [Godot.VInt{loop_mode}])

def get_loop_mode(self: Godot.Object) -> IO(U32):
  Godot.call_int(self, "get_loop_mode", [])

def set_step(self: Godot.Object, size_sec: F32) -> IO(Unit):
  Godot.run(self, "set_step", [Godot.VFloat{size_sec}])

def get_step(self: Godot.Object) -> IO(F32):
  Godot.call_float(self, "get_step", [])

def clear(self: Godot.Object) -> IO(Unit):
  Godot.run(self, "clear", [])

def copy_track(
  self: Godot.Object, track_idx: U32, to_animation: Godot.Object
) -> IO(Unit):
  Godot.run(self, "copy_track", [
    Godot.VInt{track_idx}, Godot.VObj{to_animation}])

def optimize(self: Godot.Object) -> IO(Unit):
  Godot.run(self, "optimize", [])

def optimize.all(
  self: Godot.Object, allowed_velocity_err: F32, allowed_angular_err: F32,
  precision: U32
) -> IO(Unit):
  Godot.run(self, "optimize", [
    Godot.VFloat{allowed_velocity_err}, Godot.VFloat{allowed_angular_err},
    Godot.VInt{precision}])

def compress(self: Godot.Object) -> IO(Unit):
  Godot.run(self, "compress", [])

def compress.all(
  self: Godot.Object, page_size: U32, fps: U32, split_tolerance: F32
) -> IO(Unit):
  Godot.run(self, "compress", [
    Godot.VInt{page_size}, Godot.VInt{fps}, Godot.VFloat{split_tolerance}])

def is_capture_included(self: Godot.Object) -> IO(Bool):
  Godot.call_bool(self, "is_capture_included", [])

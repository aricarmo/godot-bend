def new() -> IO(Godot.Object):
  Godot.new("TileMapPattern")

def set_cell(self: Godot.Object, coords: Godot.Vec2i) -> IO(Unit):
  Godot.run(self, "set_cell", [Godot.vec2i(coords)])

def set_cell.all(
  self: Godot.Object, coords: Godot.Vec2i, source_id: U32,
  atlas_coords: Godot.Vec2i, alternative_tile: U32
) -> IO(Unit):

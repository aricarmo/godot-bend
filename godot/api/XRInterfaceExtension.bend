# XRInterfaceExtension
# ====================

# Godot's XRInterfaceExtension (inherits XRInterface), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 5
# methods; left out: 32 virtual.
# An inherited method is in XRInterface.bend: objects are one type,
# so it takes a XRInterfaceExtension as it is.
import Base
import ../Godot.bend as Godot

def new() -> IO(Godot.Object):
  Godot.new("XRInterfaceExtension")

def get_color_texture(self: Godot.Object) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "get_color_texture", [])
    return Godot.to_rid(v)


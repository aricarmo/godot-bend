def add_blit(
  self: Godot.Object, render_target: Godot.Rid, src_rect: Godot.Rect2,
  dst_rect: Godot.Rect2i, use_layer: Bool, layer: U32,
  apply_lens_distortion: Bool, eye_center: Godot.Vec2, k1: F32, k2: F32,
  upscale: F32, aspect_ratio: F32
) -> IO(Unit):
  Godot.run(self, "add_blit", [
    Godot.rid(render_target), Godot.rect2(src_rect), Godot.rect2i(dst_rect),
    Godot.VBool{use_layer}, Godot.VInt{layer},
    Godot.VBool{apply_lens_distortion}, Godot.vec2(eye_center),
    Godot.VFloat{k1}, Godot.VFloat{k2}, Godot.VFloat{upscale},
    Godot.VFloat{aspect_ratio}])

def get_render_target_texture(
  self: Godot.Object, render_target: Godot.Rid
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "get_render_target_texture", [Godot.rid(render_target)])
    return Godot.to_rid(v)

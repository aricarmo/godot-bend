# Shape2D
# =======

# Godot's Shape2D (inherits Resource), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 8
# methods; left out: none.
# An inherited method is in Resource.bend: objects are one type,
# so it takes a Shape2D as it is.
import Base
import ../Godot.bend as Godot

def set_custom_solver_bias(self: Godot.Object, bias: F32) -> IO(Unit):
  Godot.run(self, "set_custom_solver_bias", [Godot.VFloat{bias}])

def get_custom_solver_bias(self: Godot.Object) -> IO(F32):
  Godot.call_float(self, "get_custom_solver_bias", [])

def collide(
  self: Godot.Object, local_xform: Godot.Transform2D, with_shape: Godot.Object,
  shape_xform: Godot.Transform2D
) -> IO(Bool):
  Godot.call_bool(self, "collide", [
    Godot.transform2d(local_xform), Godot.VObj{with_shape},
    Godot.transform2d(shape_xform)])

def collide_with_motion(
  self: Godot.Object, local_xform: Godot.Transform2D, local_motion: Godot.Vec2,
  with_shape: Godot.Object, shape_xform: Godot.Transform2D,
  shape_motion: Godot.Vec2
) -> IO(Bool):
  Godot.call_bool(self, "collide_with_motion", [
    Godot.transform2d(local_xform), Godot.vec2(local_motion),
    Godot.VObj{with_shape}, Godot.transform2d(shape_xform),
    Godot.vec2(shape_motion)])

def collide_and_get_contacts(
  self: Godot.Object, local_xform: Godot.Transform2D, with_shape: Godot.Object,
  shape_xform: Godot.Transform2D
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "collide_and_get_contacts", [
    Godot.transform2d(local_xform), Godot.VObj{with_shape},
    Godot.transform2d(shape_xform)])

def collide_with_motion_and_get_contacts(
  self: Godot.Object, local_xform: Godot.Transform2D, local_motion: Godot.Vec2,
  with_shape: Godot.Object, shape_xform: Godot.Transform2D,
  shape_motion: Godot.Vec2
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "collide_with_motion_and_get_contacts", [
    Godot.transform2d(local_xform), Godot.vec2(local_motion),
    Godot.VObj{with_shape}, Godot.transform2d(shape_xform),
    Godot.vec2(shape_motion)])

def draw(
  self: Godot.Object, canvas_item: Godot.Rid, color: Godot.Color
) -> IO(Unit):
  Godot.run(self, "draw", [Godot.rid(canvas_item), Godot.color(color)])

def get_rect(self: Godot.Object) -> IO(Godot.Rect2):
  do IO<Godot.Rect2>:
    v : Godot.Variant <- Godot.call(self, "get_rect", [])
    return Godot.to_rect2(v)

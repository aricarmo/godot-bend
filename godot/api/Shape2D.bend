import Base
import ../Godot.bend as Godot

def set_custom_solver_bias(self: Godot.Object, bias: F32) -> IO(Unit):
  Godot.run(self, "set_custom_solver_bias", [Godot.VFloat{bias}])

def get_custom_solver_bias(self: Godot.Object) -> IO(F32):
  Godot.call_float(self, "get_custom_solver_bias", [])

def get_rect(self: Godot.Object) -> IO(Godot.Variant):
  Godot.call(self, "get_rect", [])

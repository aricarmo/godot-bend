# Texture2DRD
# ===========

# Godot's Texture2DRD (inherits Texture2D), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 2
# methods; left out: none.
# An inherited method is in Texture2D.bend: objects are one type,
# so it takes a Texture2DRD as it is.
import Base
import ../Godot.bend as Godot

def new() -> IO(Godot.Object):
  Godot.new("Texture2DRD")

def set_texture_rd_rid(
  self: Godot.Object, texture_rd_rid: Godot.Rid
) -> IO(Unit):
  Godot.run(self, "set_texture_rd_rid", [Godot.rid(texture_rd_rid)])

def get_texture_rd_rid(self: Godot.Object) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "get_texture_rd_rid", [])
    return Godot.to_rid(v)

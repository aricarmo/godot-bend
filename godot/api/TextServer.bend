def parse_structured_text(
  self: Godot.Object, parser_type: U32, args: List<&2, Godot.Variant>,
  text: String
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "parse_structured_text", [
    Godot.VInt{parser_type}, Godot.VArr{args}, Godot.VStr{text}])

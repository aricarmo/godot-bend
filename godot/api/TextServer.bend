def percent_sign.all(self: Godot.Object, language: String) -> IO(String):
  Godot.call_str(self, "percent_sign", [Godot.VStr{language}])

def string_get_word_breaks(
  self: Godot.Object, string: String
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "string_get_word_breaks", [Godot.VStr{string}])

def string_get_word_breaks.all(
  self: Godot.Object, string: String, language: String, chars_per_line: U32
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "string_get_word_breaks", [
    Godot.VStr{string}, Godot.VStr{language}, Godot.VInt{chars_per_line}])

def string_get_character_breaks(
  self: Godot.Object, string: String
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "string_get_character_breaks", [Godot.VStr{string}])

def string_get_character_breaks.all(
  self: Godot.Object, string: String, language: String
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "string_get_character_breaks", [
    Godot.VStr{string}, Godot.VStr{language}])

def is_confusable(
  self: Godot.Object, string: String, dict: List<&2, Godot.Variant>
) -> IO(U32):
  Godot.call_int(self, "is_confusable", [
    Godot.VStr{string}, Godot.VPacked{34, dict}])

def spoof_check(self: Godot.Object, string: String) -> IO(Bool):
  Godot.call_bool(self, "spoof_check", [Godot.VStr{string}])

def strip_diacritics(self: Godot.Object, string: String) -> IO(String):
  Godot.call_str(self, "strip_diacritics", [Godot.VStr{string}])

def is_valid_identifier(self: Godot.Object, string: String) -> IO(Bool):
  Godot.call_bool(self, "is_valid_identifier", [Godot.VStr{string}])

def is_valid_letter(self: Godot.Object, unicode: U32) -> IO(Bool):
  Godot.call_bool(self, "is_valid_letter", [Godot.VInt{unicode}])

def string_to_upper(self: Godot.Object, string: String) -> IO(String):
  Godot.call_str(self, "string_to_upper", [Godot.VStr{string}])

def string_to_upper.all(
  self: Godot.Object, string: String, language: String
) -> IO(String):
  Godot.call_str(self, "string_to_upper", [
    Godot.VStr{string}, Godot.VStr{language}])

def string_to_lower(self: Godot.Object, string: String) -> IO(String):
  Godot.call_str(self, "string_to_lower", [Godot.VStr{string}])

def string_to_lower.all(
  self: Godot.Object, string: String, language: String

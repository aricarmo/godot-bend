def texture_create(
  self: Godot.Object, format: Godot.Object, view: Godot.Object
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create", [Godot.VObj{format}, Godot.VObj{view}])
    return Godot.to_rid(v)

def texture_create.all(
  self: Godot.Object, format: Godot.Object, view: Godot.Object,
  data: List<&2, Godot.Variant>
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create", [Godot.VObj{format}, Godot.VObj{view}, Godot.VArr{data}])
    return Godot.to_rid(v)

def texture_create_shared(
  self: Godot.Object, view: Godot.Object, with_texture: Godot.Rid
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create_shared", [Godot.VObj{view}, Godot.rid(with_texture)])
    return Godot.to_rid(v)

def texture_create_shared_from_slice(
  self: Godot.Object, view: Godot.Object, with_texture: Godot.Rid, layer: U32,
  mipmap: U32
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create_shared_from_slice", [Godot.VObj{view}, Godot.rid(with_texture), Godot.VInt{layer}, Godot.VInt{mipmap}])
    return Godot.to_rid(v)

def texture_create_shared_from_slice.all(
  self: Godot.Object, view: Godot.Object, with_texture: Godot.Rid, layer: U32,
  mipmap: U32, mipmaps: U32, slice_type: U32
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create_shared_from_slice", [Godot.VObj{view}, Godot.rid(with_texture), Godot.VInt{layer}, Godot.VInt{mipmap}, Godot.VInt{mipmaps}, Godot.VInt{slice_type}])
    return Godot.to_rid(v)

def texture_create_from_extension(
  self: Godot.Object, type_: U32, format: U32, samples: U32, usage_flags: U32,
  image: U32, width: U32, height: U32, depth: U32, layers: U32
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create_from_extension", [Godot.VInt{type_}, Godot.VInt{format}, Godot.VInt{samples}, Godot.VInt{usage_flags}, Godot.VInt{image}, Godot.VInt{width}, Godot.VInt{height}, Godot.VInt{depth}, Godot.VInt{layers}])
    return Godot.to_rid(v)

def texture_create_from_extension.all(
  self: Godot.Object, type_: U32, format: U32, samples: U32, usage_flags: U32,
  image: U32, width: U32, height: U32, depth: U32, layers: U32, mipmaps: U32
) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "texture_create_from_extension", [Godot.VInt{type_}, Godot.VInt{format}, Godot.VInt{samples}, Godot.VInt{usage_flags}, Godot.VInt{image}, Godot.VInt{width}, Godot.VInt{height}, Godot.VInt{depth}, Godot.VInt{layers}, Godot.VInt{mipmaps}])
    return Godot.to_rid(v)

def texture_update(
  self: Godot.Object, texture: Godot.Rid, layer: U32,
  data: List<&2, Godot.Variant>
) -> IO(U32):
  Godot.call_int(self, "texture_update", [
    Godot.rid(texture), Godot.VInt{layer}, Godot.VPacked{29, data}])

def texture_get_data(
  self: Godot.Object, texture: Godot.Rid, layer: U32
) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "texture_get_data", [
    Godot.rid(texture), Godot.VInt{layer}])

def texture_get_data_async(
  self: Godot.Object, texture: Godot.Rid, layer: U32, callback: U32
) -> IO(U32):
  Godot.call_int(self, "texture_get_data_async", [
    Godot.rid(texture), Godot.VInt{layer}, Godot.VCall{callback}])

def texture_is_format_supported_for_usage(
  self: Godot.Object, format: U32, usage_flags: U32
) -> IO(Bool):
  Godot.call_bool(self, "texture_is_format_supported_for_usage", [
    Godot.VInt{format}, Godot.VInt{usage_flags}])

def texture_is_shared(self: Godot.Object, texture: Godot.Rid) -> IO(Bool):
  Godot.call_bool(self, "texture_is_shared", [Godot.rid(texture)])

def texture_is_valid(self: Godot.Object, texture: Godot.Rid) -> IO(Bool):
  Godot.call_bool(self, "texture_is_valid", [Godot.rid(texture)])

def texture_set_discardable(
  self: Godot.Object, texture: Godot.Rid, discardable: Bool
) -> IO(Unit):
  Godot.run(self, "texture_set_discardable", [
    Godot.rid(texture), Godot.VBool{discardable}])

def texture_is_discardable(self: Godot.Object, texture: Godot.Rid) -> IO(Bool):
  Godot.call_bool(self, "texture_is_discardable", [Godot.rid(texture)])

def texture_copy(
  self: Godot.Object, from_texture: Godot.Rid, to_texture: Godot.Rid,
  from_pos: Godot.Vec3, to_pos: Godot.Vec3, size: Godot.Vec3, src_mipmap: U32,
  dst_mipmap: U32, src_layer: U32, dst_layer: U32
) -> IO(U32):
  Godot.call_int(self, "texture_copy", [
    Godot.rid(from_texture), Godot.rid(to_texture), Godot.vec3(from_pos),
    Godot.vec3(to_pos), Godot.vec3(size), Godot.VInt{src_mipmap},
    Godot.VInt{dst_mipmap}, Godot.VInt{src_layer}, Godot.VInt{dst_layer}])

def texture_clear(
  self: Godot.Object, texture: Godot.Rid, color: Godot.Color, base_mipmap: U32,
  mipmap_count: U32, base_layer: U32, layer_count: U32
) -> IO(U32):
  Godot.call_int(self, "texture_clear", [
    Godot.rid(texture), Godot.color(color), Godot.VInt{base_mipmap},
    Godot.VInt{mipmap_count}, Godot.VInt{base_layer}, Godot.VInt{layer_count}])

def texture_resolve_multisample(
  self: Godot.Object, from_texture: Godot.Rid, to_texture: Godot.Rid
) -> IO(U32):
  Godot.call_int(self, "texture_resolve_multisample", [
    Godot.rid(from_texture), Godot.rid(to_texture)])

def texture_get_format(
  self: Godot.Object, texture: Godot.Rid
) -> IO(Godot.Object):
  Godot.call_obj(self, "texture_get_format", [Godot.rid(texture)])

def texture_get_native_handle(
  self: Godot.Object, texture: Godot.Rid
) -> IO(U32):
  Godot.call_int(self, "texture_get_native_handle", [Godot.rid(texture)])

def framebuffer_format_create(
  self: Godot.Object, attachments: List<&2, Godot.Variant>
) -> IO(U32):
  Godot.call_int(self, "framebuffer_format_create", [Godot.VArr{attachments}])

def framebuffer_format_create.all(
  self: Godot.Object, attachments: List<&2, Godot.Variant>, view_count: U32
) -> IO(U32):
  Godot.call_int(self, "framebuffer_format_create", [

# EditorCommandPalette
# ====================

# Godot's EditorCommandPalette (inherits ConfirmationDialog), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 2
# methods; left out: none.
# An inherited method is in ConfirmationDialog.bend: objects are one type,
# so it takes a EditorCommandPalette as it is.
import Base
import ../Godot.bend as Godot

def new() -> IO(Godot.Object):
  Godot.new("EditorCommandPalette")

def add_command(
  self: Godot.Object, command_name: String, key_name: String,
  binded_callable: U32
) -> IO(Unit):
  Godot.run(self, "add_command", [
    Godot.VStr{command_name}, Godot.VStr{key_name},
    Godot.VCall{binded_callable}])

def add_command.all(
  self: Godot.Object, command_name: String, key_name: String,
  binded_callable: U32, shortcut_text: String
) -> IO(Unit):
  Godot.run(self, "add_command", [
    Godot.VStr{command_name}, Godot.VStr{key_name},
    Godot.VCall{binded_callable}, Godot.VStr{shortcut_text}])

def remove_command(self: Godot.Object, key_name: String) -> IO(Unit):
  Godot.run(self, "remove_command", [Godot.VStr{key_name}])

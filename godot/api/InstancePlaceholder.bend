import Base
import ../Godot.bend as Godot

def get_stored_values(self: Godot.Object) -> IO(Godot.Variant):
  Godot.call(self, "get_stored_values", [])

def get_stored_values.all(
  self: Godot.Object, with_order: Bool
) -> IO(Godot.Variant):
  Godot.call(self, "get_stored_values", [Godot.VBool{with_order}])

def create_instance(self: Godot.Object) -> IO(Godot.Object):
  Godot.call_obj(self, "create_instance", [])

def create_instance.all(
  self: Godot.Object, replace: Bool, custom_scene: Godot.Object
) -> IO(Godot.Object):
  Godot.call_obj(self, "create_instance", [
    Godot.VBool{replace}, Godot.VObj{custom_scene}])

def get_instance_path(self: Godot.Object) -> IO(String):
  Godot.call_str(self, "get_instance_path", [])

def set_navigation_map(
  self: Godot.Object, layer: U32, map: Godot.Rid
) -> IO(Unit):
  Godot.run(self, "set_navigation_map", [Godot.VInt{layer}, Godot.rid(map)])

def get_navigation_map(self: Godot.Object, layer: U32) -> IO(Godot.Rid):
  do IO<Godot.Rid>:
    v : Godot.Variant <- Godot.call(self, "get_navigation_map", [Godot.VInt{layer}])
    return Godot.to_rid(v)


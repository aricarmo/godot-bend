# EditorToaster
# =============

# Godot's EditorToaster (inherits HBoxContainer), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 1
# methods; left out: none.
# An inherited method is in HBoxContainer.bend: objects are one type,
# so it takes a EditorToaster as it is.
import Base
import ../Godot.bend as Godot

def SEVERITY_INFO() -> U32:
  0

def SEVERITY_WARNING() -> U32:
  1

def SEVERITY_ERROR() -> U32:
  2

def push_toast(self: Godot.Object, message: String) -> IO(Unit):
  Godot.run(self, "push_toast", [Godot.VStr{message}])

def push_toast.all(
  self: Godot.Object, message: String, severity: U32, tooltip: String
) -> IO(Unit):
  Godot.run(self, "push_toast", [
    Godot.VStr{message}, Godot.VInt{severity}, Godot.VStr{tooltip}])

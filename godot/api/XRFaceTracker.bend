def get_blend_shape(self: Godot.Object, blend_shape: U32) -> IO(F32):
  Godot.call_float(self, "get_blend_shape", [Godot.VInt{blend_shape}])

def set_blend_shape(
  self: Godot.Object, blend_shape: U32, weight: F32
) -> IO(Unit):
  Godot.run(self, "set_blend_shape", [
    Godot.VInt{blend_shape}, Godot.VFloat{weight}])

def get_blend_shapes(self: Godot.Object) -> IO(Godot.Variant):

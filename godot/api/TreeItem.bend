def get_child(self: Godot.Object, index: U32) -> IO(Godot.Object):
  Godot.call_obj(self, "get_child", [Godot.VInt{index}])

def get_child_count(self: Godot.Object) -> IO(U32):
  Godot.call_int(self, "get_child_count", [])

def get_children(self: Godot.Object) -> IO(List<&2, Godot.Variant>):
  Godot.call_list(self, "get_children", [])

def get_index(self: Godot.Object) -> IO(U32):
  Godot.call_int(self, "get_index", [])

def move_before(self: Godot.Object, item: Godot.Object) -> IO(Unit):
  Godot.run(self, "move_before", [Godot.VObj{item}])

def move_after(self: Godot.Object, item: Godot.Object) -> IO(Unit):
  Godot.run(self, "move_after", [Godot.VObj{item}])

def call_recursive(
  self: Godot.Object, method: String, rest: List<&2, Godot.Variant>
) -> IO(Unit):
  Godot.run(self, "call_recursive",
    List.append(&2, Godot.Variant, [Godot.VStr{method}], rest))

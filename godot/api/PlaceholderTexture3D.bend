# PlaceholderTexture3D
# ====================

# Godot's PlaceholderTexture3D (inherits Texture3D), generated by tools/gen_api.py from
# extension_api.json; edit the generator, not this file. 2
# methods; left out: none.
# An inherited method is in Texture3D.bend: objects are one type,
# so it takes a PlaceholderTexture3D as it is.
import Base
import ../Godot.bend as Godot

def new() -> IO(Godot.Object):
  Godot.new("PlaceholderTexture3D")

def set_size(self: Godot.Object, size: Godot.Vec3i) -> IO(Unit):
  Godot.run(self, "set_size", [Godot.vec3i(size)])

def get_size(self: Godot.Object) -> IO(Godot.Vec3i):
  do IO<Godot.Vec3i>:
    v : Godot.Variant <- Godot.call(self, "get_size", [])
    return Godot.to_vec3i(v)
